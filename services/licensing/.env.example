# Obtain a restricted live key from Stripe. Never commit the real value.
STRIPE_SECRET_KEY=rk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Official Magnexis Super Lightning one-time prices. These are public Stripe Price IDs, not secrets.
STRIPE_INDIVIDUAL_PRICE_ID=price_1UUpd5DTgI7PpvvUO93U8pcB
STRIPE_BUSINESS_PRICE_ID=price_1UUpdEDTgI7PpvvUbHI4CnyH

# Ed25519 private PEM. Keep in a secret manager, never in this file.
SUPER_LIGHTNING_LICENSE_PRIVATE_KEY=replace_with_private_pem
# A single public HTTPS hostname lets the service derive Stripe success/cancel URLs.
LICENSING_PUBLIC_BASE_URL=https://licenses.example.com
# Alternatively, set both explicitly:
# LICENSING_SUCCESS_URL=https://licenses.example.com/success?session_id={CHECKOUT_SESSION_ID}
# LICENSING_CANCEL_URL=https://licenses.example.com/cancel
LICENSING_PORT=4242
LICENSE_FULFILLMENT_PATH=./data/fulfilled-sessions.json
